# =============================================================================
# ApnaStore Web — Production Environment Example
# Used at Vite build time (import.meta.env.VITE_*).
# Copy to apps/web/.env.production before `npm run build`.
# Source of truth: apps/web/src/lib/apiClient.js, constants/index.js, lib/socket.js
# =============================================================================

# Public API base URL for the browser (HTTP + Socket.io origin derivation).
# Same-origin Nginx proxy (recommended on Hostinger):
VITE_API_URL=/api/v1

# Absolute API URL alternative (only if web and API are on different origins):
# VITE_API_URL=https://apnastore.org/api/v1
