# =============================================================================
# ApnaStore API — Environment Variables
# Copy to .env and fill in values. Never commit real secrets.
# =============================================================================

NODE_ENV=development
APP_NAME=ApnaStore API
APP_URL=http://localhost:4000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000

# Server
PORT=4000
HOST=0.0.0.0

# MongoDB (self-hosted on Hostinger VPS in production)
MONGODB_URI=mongodb://127.0.0.1:27017/apnastore
MONGODB_DB_NAME=apnastore

# JWT (generate strong secrets for production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,https://apnastore.org

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Uploads (product images: JPG/PNG/WEBP up to 25 MB)
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE_MB=25

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# Cron / jobs (MUST be true in production)
ENABLE_JOBS=false
ESCROW_AUTO_RELEASE_HOURS=24
WITHDRAWAL_ADMIN_SLA_HOURS=24

# Cryptomus payment gateway (only supported gateway)
# Production requires merchant+key, MODE=production, ENFORCE_IP_WHITELIST=true
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=
CRYPTOMUS_WEBHOOK_SECRET=
CRYPTOMUS_BASE_URL=https://api.cryptomus.com/v1
CRYPTOMUS_MODE=sandbox
CRYPTOMUS_URL_RETURN=
CRYPTOMUS_URL_SUCCESS=
CRYPTOMUS_ENFORCE_IP_WHITELIST=false

# Email (production SMTP — e.g. Hostinger / SendGrid / Amazon SES)
# Required in production for forgot-password / transactional mail.
# Missing SMTP_HOST / SMTP_USER / SMTP_PASS will cause send failures (no silent success).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@apnastore.org
EMAIL_REPLY_TO=

# Seed admin (used by `npm run seed`)
SEED_ADMIN_EMAIL=admin.apnastore@gmail.com
# SEED_ADMIN_PASSWORD=  # required when seeding admin (min 8 chars)
# SEED_ADMIN=true       # required to seed admin when NODE_ENV=production

# Optional Redis (multi-instance Socket.io / BullMQ later)
REDIS_URL=

# Dispute credential encryption (AES-256-GCM). Use a unique ≥32 char secret in production.
CREDENTIALS_ENCRYPTION_KEY=change-me-credentials-encryption-key-min-32
DISPUTE_CREDENTIAL_TTL_DAYS=30

# Telegram bot notifications (production APIs only — api.telegram.org)
# Never put TELEGRAM_BOT_TOKEN in frontend code or commit it to git.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=Apnastorenotifications_bot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://apnastore.org/api/v1/telegram/webhook
# webhook = production (Nginx forwards /api/); polling = local development
TELEGRAM_MODE=webhook
#
# Chat IDs are NOT configured here.
# Each buyer/seller links their own telegramChatId via Profile → Connect Telegram
# (stored on the User document; never exposed in public API responses).
# Admin broadcasts go to connected users from Admin → Marketplace Ops → Telegram.

# Google OAuth 2 (optional). When empty, /auth/google returns 503 and UI shows not configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to `${APP_URL}${API_PREFIX}/auth/google/callback` when empty
GOOGLE_CALLBACK_URL=

# Buyer wallet Cryptomus deposit / top-up limits (USD)
BUYER_WALLET_MIN_DEPOSIT=5
BUYER_WALLET_MAX_DEPOSIT=10000
