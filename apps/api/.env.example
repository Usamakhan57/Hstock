# =============================================================================
# HStock API — Environment Variables
# Copy to .env and fill in values. Never commit real secrets.
# =============================================================================

NODE_ENV=development
APP_NAME=HStock API
APP_URL=http://localhost:4000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000

# Server
PORT=4000
HOST=0.0.0.0

# MongoDB (self-hosted on Hostinger VPS in production)
MONGODB_URI=mongodb://127.0.0.1:27017/hstock
MONGODB_DB_NAME=hstock

# JWT (generate strong secrets for production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,https://hstock.store

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Uploads
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE_MB=10

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# Cron / jobs (enable in production)
ENABLE_JOBS=false
ESCROW_AUTO_RELEASE_HOURS=24
WITHDRAWAL_ADMIN_SLA_HOURS=24

# Cryptomus payment gateway (only supported gateway)
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=
CRYPTOMUS_WEBHOOK_SECRET=
CRYPTOMUS_BASE_URL=https://api.cryptomus.com/v1
CRYPTOMUS_MODE=sandbox
CRYPTOMUS_URL_RETURN=
CRYPTOMUS_URL_SUCCESS=
CRYPTOMUS_ENFORCE_IP_WHITELIST=false

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@hstock.store
