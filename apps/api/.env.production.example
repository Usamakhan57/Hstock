# =============================================================================
# ApnaStore API — Production Environment Example
# Copy to apps/api/.env on the VPS. Never commit real secrets.
# Source of truth: apps/api/src/config/env.js (+ seed.js / deploy scripts)
# =============================================================================

# --- Core (API) ---
NODE_ENV=production
APP_NAME=ApnaStore API
APP_URL=https://apnastore.org
API_PREFIX=/api/v1
FRONTEND_URL=https://apnastore.org

# --- Server (API) ---
PORT=4000
HOST=0.0.0.0

# --- MongoDB ---
MONGODB_URI=mongodb://127.0.0.1:27017/apnastore
MONGODB_DB_NAME=apnastore

# --- Auth / JWT (API) — generate unique ≥32 char secrets ---
JWT_ACCESS_SECRET=replace-with-unique-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-unique-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Dispute credential encryption (API) — required in production ---
CREDENTIALS_ENCRYPTION_KEY=replace-with-unique-aes-key-material-min-32
DISPUTE_CREDENTIAL_TTL_DAYS=30

# --- Cookies (API / Auth) ---
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=.apnastore.org

# --- CORS (API / Socket.io) — comma-separated, no * ---
CORS_ORIGINS=https://apnastore.org,https://www.apnastore.org

# --- Rate limiting (API) ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# --- Uploads (API) ---
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE_MB=10

# --- Logging (API) ---
LOG_LEVEL=info
LOG_DIR=logs

# --- Background jobs (API / Cron) — required true for escrow/payment jobs ---
ENABLE_JOBS=true
ESCROW_AUTO_RELEASE_HOURS=24
WITHDRAWAL_ADMIN_SLA_HOURS=24

# --- Cryptomus (Payments) — all production-enforced ---
CRYPTOMUS_MERCHANT_ID=your-cryptomus-merchant-id
CRYPTOMUS_API_KEY=your-cryptomus-api-key
CRYPTOMUS_WEBHOOK_SECRET=your-cryptomus-webhook-secret
CRYPTOMUS_BASE_URL=https://api.cryptomus.com/v1
CRYPTOMUS_MODE=production
CRYPTOMUS_URL_RETURN=https://apnastore.org/orders
CRYPTOMUS_URL_SUCCESS=https://apnastore.org/order-success
CRYPTOMUS_ENFORCE_IP_WHITELIST=true

# --- SMTP (Email) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=noreply@apnastore.org
SMTP_PASS=replace-with-smtp-password
EMAIL_FROM=ApnaStore <noreply@apnastore.org>

# --- Redis (optional — Socket.io adapter / queues when scaling) ---
REDIS_URL=

# --- Seed script only (apps/api/src/scripts/seed.js) — not needed for normal boot ---
# SEED_ADMIN=true
# SEED_ADMIN_EMAIL=admin@apnastore.org
# SEED_ADMIN_PASSWORD=replace-with-strong-admin-password

# --- Deploy / backup scripts (shell) — used by deploy/scripts/*.sh ---
# BACKUP_DIR=/var/backups/apnastore
# RETENTION_DAYS=14
# FORCE_RESTORE=0
# WEB_DIST_TARGET=/var/www/apnastore/web
